">>> '{:_x}'.format(1234567890)\n"
"'4996_02d2'\n"
">>> '{:_}'.format(123456789.123456789)\n"
"'123_456_789.12345679'\n"
">>> '{:.,}'.format(123456789.123456789)\n"
"'123456789.123,456,79'\n"
">>> '{:,._}'.format(123456789.123456789)\n"
"'123,456,789.123_456_79'"
